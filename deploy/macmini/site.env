# Non-secret site settings for this fork's Mac mini deployment.
# setup.sh uses these as defaults when a step's arguments are omitted.
# Never put secrets here: this file is committed to a public repo. Secrets are
# generated on the Mac mini into deploy/compose/.env, which is gitignored.

# Public hostname served through the Cloudflare tunnel (zone: magibu.ai).
BUZZ_HOSTNAME=buzz.magibu.ai

# Relay owner: your desktop identity's public key (npub1… or 64-char hex).
# Public keys are not secret. Leave empty to pass it to `setup.sh env` instead.
BUZZ_OWNER=
